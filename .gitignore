# Ignore the vendored/upstream Codex checkout by default.
*

# Keep the app repository shell.
!/.gitignore
!/README.md
!/local-codex-app/

# Keep the Local Codex app source and docs.
!/local-codex-app/README.md
!/local-codex-app/Package.swift
!/local-codex-app/Sources/
!/local-codex-app/Sources/**
!/local-codex-app/script/
!/local-codex-app/script/**
!/local-codex-app/.codex/
!/local-codex-app/.codex/environments/
!/local-codex-app/.codex/environments/environment.toml

# Generated or machine-local app output.
local-codex-app/.build/
local-codex-app/dist/
local-codex-app/.swiftpm/
local-codex-app/DerivedData/

# macOS/editor noise.
.DS_Store
Icon?
*.swp
*~
